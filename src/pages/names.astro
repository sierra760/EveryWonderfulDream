---
import Base from '../layouts/Base.astro';
import { loadSummary } from '../lib/summary';

const summary = loadSummary() as any;
const nf = new Intl.NumberFormat('en-US');
const letters: [string, number][] = Object.entries(summary.nameLetters ?? {});
const places = summary.places.map((p: any) => p.name);
---

<Base title="Names" description={`An A–Z index of the ${nf.format(summary.patentees)} people named on small-tract patents in San Bernardino County.`}>
  <header class="page-hero wrap">
    <p class="eyebrow">Names</p>
    <h1>The people <em>on the patents</em></h1>
    <p class="lede">
      Find a surname and follow it to the land. The index lists {nf.format(summary.patentees)} names from
      the Bureau of Land Management’s records for {nf.format(summary.withNames)} patents.
    </p>
  </header>

  <section class="wrap names" id="names" data-places={JSON.stringify(places)}>
    <div class="bar">
      <label class="sr-only" for="nq">Surname</label>
      <input id="nq" name="q" type="search" placeholder="Try Sem…" autocomplete="off" spellcheck="false" />
      <nav class="letters" aria-label="Initial">
        {letters.map(([l, n]) => (
          <a href={`?l=${l}`} data-letter={l} title={`${nf.format(n)} names`}>{l}</a>
        ))}
      </nav>
    </div>
    <p class="status mono" id="nstatus" aria-live="polite">Choose a letter, or type a surname.</p>
    <ol class="list" id="nlist"></ol>
  </section>

  <section class="section wrap-narrow">
    <div class="prose" style="margin-top:1.2rem">
      <h2>About these names</h2>
      <p>
        BLM released its California patent index in 1997 under the Freedom of Information Act. Larry
        Vredenburgh published it. The index uses capitals, puts surnames first, and stops at 30 characters.
        Long names can be cut short, and a two-word surname can be filed under the wrong letter. Each tract
        page shows the original index entry and links to the scanned patent.
      </p>
      <p>
        The patent names the people who received title. Other family members may be missing from the index,
        as are people whose leases never became patents.
      </p>
    </div>
  </section>
</Base>

<style is:global>
  .names {
    padding-block: clamp(2rem, 5vw, 3.5rem) 1rem;
  }
  .names .bar {
    position: sticky;
    top: var(--header-h);
    z-index: 5;
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) 1fr;
    gap: 1rem 2rem;
    align-items: center;
    padding: 0.9rem 0;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--ink);
  }
  .names input {
    width: 100%;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--ink);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 0.6rem 0.9rem;
  }
  .names input:focus-visible {
    border-color: var(--ochre);
  }
  .letters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
  }
  .letters a {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-decoration: none;
    width: 1.9rem;
    height: 1.9rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--ink-2);
  }
  .letters a:hover {
    background: var(--paper-3);
    color: var(--ink);
  }
  .letters a[aria-current='true'] {
    background: var(--ochre);
    color: #fff7e8;
  }
  .names .status {
    margin: 1.2rem 0 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .names .list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 20rem;
    column-gap: 2.5rem;
  }
  .names .list li {
    break-inside: avoid;
  }
  .names .list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 0.8rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  .names .list .nm {
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 1.25;
  }
  .names .list .yr,
  .names .list .pl {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    color: var(--ink-3);
  }
  .names .list .yr {
    align-self: center;
  }
  .names .list .pl {
    grid-column: 1 / -1;
  }
  .names .list a:hover .nm {
    color: var(--ochre);
  }
  @media (max-width: 700px) {
    .names .bar {
      grid-template-columns: 1fr;
      position: static;
    }
  }
</style>

<script>
  import { BASE, getJson } from '../lib/data';
  import { labelFromId } from '../lib/format';

  type Row = [label: string, id: string, year: number, place: number];

  const root = document.getElementById('names')!;
  const places: string[] = JSON.parse(root.dataset.places ?? '[]');
  const input = document.getElementById('nq') as HTMLInputElement;
  const list = document.getElementById('nlist')!;
  const status = document.getElementById('nstatus')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.letters a')];
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const nf = new Intl.NumberFormat('en-US');
  let token = 0;

  async function show(letter: string, prefix = '') {
    const mine = ++token;
    letter = letter.toUpperCase();
    links.forEach((a) => a.setAttribute('aria-current', String(a.dataset.letter === letter)));
    if (!links.some((a) => a.dataset.letter === letter)) {
      list.innerHTML = '';
      status.textContent = 'No matches. Try a surname or choose a letter.';
      return;
    }
    status.textContent = 'Loading…';
    let rows: Row[];
    try {
      rows = await getJson<Row[]>(`names/${letter}.json`);
    } catch {
      if (mine !== token) return;
      list.replaceChildren();
      status.textContent = 'Couldn’t load the names. Try searching again or choose a letter.';
      return;
    }
    if (mine !== token) return;
    const p = prefix.trim().toLowerCase();
    const hits = p.length > 1 ? rows.filter((r) => r[0].toLowerCase().startsWith(p)) : rows;
    status.textContent = !hits.length
      ? 'No matches. Try a shorter spelling.'
      : p.length > 1
        ? `${nf.format(hits.length)} name${hits.length === 1 ? '' : 's'} beginning “${prefix.trim()}”`
        : `${nf.format(rows.length)} names under ${letter}`;
    list.innerHTML = hits.map(([label, id, year, place]) => `
      <li><a href="${BASE}/tract/?id=${encodeURIComponent(id)}">
        <span class="nm">${esc(label)}</span>
        <span class="yr">${year || ''}</span>
        <span class="pl">${esc(place >= 0 ? places[place] : 'San Bernardino County')} · ${esc(labelFromId(id))}</span>
      </a></li>`).join('');
  }

  const setUrl = (params: Record<string, string>) => {
    const q = new URLSearchParams(params).toString();
    history.replaceState(null, '', q ? `?${q}` : location.pathname);
  };

  let timer = 0;
  links.forEach((a) => a.addEventListener('click', (e) => {
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    clearTimeout(timer);
    input.value = '';
    setUrl({ l: a.dataset.letter! });
    show(a.dataset.letter!);
  }));

  input.addEventListener('input', () => {
    clearTimeout(timer);
    const v = input.value.trim();
    if (!v) {
      token++;
      links.forEach((a) => a.removeAttribute('aria-current'));
      list.replaceChildren();
      setUrl({});
      status.textContent = 'Choose a letter, or type a surname.';
      return;
    }
    timer = window.setTimeout(() => {
      setUrl({ q: v });
      show(v[0], v);
    }, 140);
  });

  const params = new URLSearchParams(location.search);
  const q = params.get('q')?.trim();
  if (q) {
    input.value = q;
    show(q[0], q);
  } else if (params.get('l')) {
    show(params.get('l')!);
  }
</script>
