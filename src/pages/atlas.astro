---
import Base from '../layouts/Base.astro';
import { loadSummary } from '../lib/summary';
import { YEAR_STOPS } from '../lib/year-colors';

const summary = loadSummary() as any;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const regions: Record<string, any[]> = {};
for (const p of summary.places) if (p.tracts) (regions[p.region] ??= []).push(p);
const nf = new Intl.NumberFormat('en-US');
const yearRamp = `linear-gradient(to right, ${YEAR_STOPS.map(([, color]) => color).join(', ')})`;
---

<Base title="The Atlas" night app description={`Explore ${nf.format(summary.tracts)} Small Tract Act homesteads across San Bernardino County on a 3D map.`}>
  <h1 class="sr-only">Atlas</h1>
  <div class="atlas">
    <div id="map" class="map-fill" aria-label="Map of every Small Tract in San Bernardino County"></div>
    <section class="map-unavailable" id="map-unavailable" hidden>
      <h2>The 3D map couldn’t open</h2>
      <p>You can still find a tract by name or browse by community.</p>
      <a class="btn glow" href={`${base}/names/`}>Search by name</a>
      <a class="btn ghost" href={`${base}/places/`}>Browse places</a>
    </section>

    <aside class="panel" id="panel" aria-label="Atlas controls">
      <div class="search">
        <label class="sr-only" for="q">Search the atlas</label>
        <input id="q" name="q" type="search" placeholder="Name, place, or tract number…" autocomplete="off" spellcheck="false" aria-describedby="atlas-search-hint" />
        <span class="sr-only" id="atlas-search-hint">You can also search by township, range, and section.</span>
        <p class="sr-only" id="atlas-search-status" role="status"></p>
        <ul id="results" class="results" hidden></ul>
      </div>

      <div class="panel-body" id="panel-body">
        <p class="count"><span class="num" id="count">{nf.format(summary.tracts)}</span> tracts · {nf.format(summary.acres)} acres · {summary.townships} townships</p>

        <div class="toggles" role="group" aria-label="Map layers">
          <button type="button" class="tg" id="tg-year" aria-pressed="false">Color by year</button>
          <button type="button" class="tg" id="tg-grid" aria-pressed="true">Survey grid</button>
          <button type="button" class="tg" id="tg-class" aria-pressed="false">Classified land</button>
          <button type="button" class="tg" id="tg-topo" aria-pressed="false">Topo map</button>
          <button type="button" class="tg" id="tg-3d" aria-pressed="true">3D</button>
        </div>
        <button type="button" class="lucky" id="lucky">Show a random tract <span aria-hidden="true">→</span></button>

        <div class="legend" id="legend" hidden>
          <div class="ramp" style={{ backgroundImage: yearRamp }}></div>
          <div class="ramp-labels mono"><span>1948</span><span>1954</span><span>1957</span><span>1960</span><span>1963</span><span>1970s</span></div>
          <p>Year the patent was issued.</p>
        </div>
        <div class="legend" id="legend-class" hidden>
          <p><span class="swatch"></span>Land BLM classified for small-tract leasing or sale. Much of it was never taken up.</p>
        </div>

        <nav class="places" aria-label="Places">
          {Object.entries(regions).map(([region, list]) => (
            <div>
              <h2>{region}</h2>
              <ul>
                {list.map((p) => (
                  <li><button type="button" data-place={p.id}><span>{p.name}</span><span class="num">{nf.format(p.tracts)}</span></button></li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>
      <button type="button" class="panel-toggle" id="panel-toggle" aria-expanded="false" aria-controls="panel-body">Places &amp; layers</button>
    </aside>

    <section class="card" id="card" hidden aria-live="polite"></section>
    <div class="hover-tip mono" id="tip" hidden></div>
    <p class="hint mono" id="hint">Zoom in to see each tract · hover for the name on the patent</p>
  </div>
</Base>

<style is:global>
  body.app {
    overflow: hidden;
  }
  .atlas {
    position: fixed;
    inset: 0;
    background: var(--night);
    color: #f3e8d4;
  }
  .map-unavailable {
    position: absolute;
    inset: 0;
    align-content: center;
    overflow: auto;
    padding: calc(var(--header-h) + 1rem) var(--gutter) 2rem;
    text-align: center;
    background: radial-gradient(at 50% 5%, var(--dusk), var(--night) 75%);
  }
  .map-unavailable h2 {
    font-size: clamp(1.8rem, 1.2rem + 2.5vw, 3rem);
    margin-bottom: 0.65em;
  }
  .map-unavailable .btn {
    margin: 0.25rem;
  }
  .panel {
    position: absolute;
    top: calc(var(--header-h) + 0.4rem);
    left: var(--gutter);
    width: min(22.5rem, calc(100vw - 2 * var(--gutter)));
    max-height: calc(100svh - var(--header-h) - 2.2rem);
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--night) 82%, transparent);
    border: 1px solid var(--rule-night);
    border-radius: 16px;
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    overflow: hidden;
    z-index: 5;
  }
  .search {
    position: relative;
    padding: 0.7rem;
    border-bottom: 1px solid var(--rule-night);
  }
  .search input {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #fff6e3;
    background: rgba(255, 240, 215, 0.07);
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 0.8rem 0.9rem;
  }
  .search input::placeholder {
    color: rgba(255, 240, 215, 0.68);
  }
  .search input:focus-visible {
    border-color: var(--glow);
    background: rgba(255, 240, 215, 0.1);
  }
  .results {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    max-height: 46svh;
    overflow: auto;
  }
  .results button {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.1rem 0.8rem;
    width: 100%;
    text-align: left;
    background: none;
    border: 0;
    border-radius: 8px;
    color: inherit;
    font: inherit;
    padding: 0.55rem 0.6rem;
    cursor: pointer;
  }
  .results button:hover,
  .results button:focus-visible {
    background: rgba(255, 214, 140, 0.14);
  }
  .results .r-main {
    font-family: var(--font-display);
    font-size: 1.02rem;
  }
  .results .r-kind,
  .results .r-sub {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    color: rgba(255, 240, 215, 0.6);
  }
  .results .r-sub {
    grid-column: 1 / -1;
  }
  .results .empty {
    padding: 0.6rem;
    font-size: 0.86rem;
    color: rgba(255, 240, 215, 0.6);
  }
  .panel-body {
    overflow: auto;
    overscroll-behavior: contain;
    padding: 0.9rem 0.9rem 1.1rem;
  }
  .count {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: rgba(255, 240, 215, 0.7);
    margin: 0 0 0.9rem;
  }
  .count .num {
    color: var(--glow);
  }
  .toggles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tg {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 240, 215, 0.85);
    background: transparent;
    border: 1px solid var(--rule-night);
    border-radius: 999px;
    padding: 0.45rem 0.75rem;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  @media (pointer: coarse) {
    .tg,
    .panel-toggle {
      min-height: 2.5rem;
    }
  }
  .tg:hover {
    border-color: var(--glow);
  }
  .tg[aria-pressed='true'] {
    background: var(--glow);
    border-color: var(--glow);
    color: var(--night);
  }
  .lucky {
    margin-top: 0.9rem;
    width: 100%;
    text-align: left;
    background: rgba(255, 214, 140, 0.08);
    border: 1px dashed rgba(255, 214, 140, 0.45);
    border-radius: 10px;
    color: var(--glow);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.02rem;
    padding: 0.6rem 0.8rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .lucky:hover {
    background: rgba(255, 214, 140, 0.18);
  }
  .legend {
    margin-top: 0.9rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: rgba(255, 240, 215, 0.7);
  }
  .legend p {
    margin: 0.4rem 0 0;
  }
  .legend .ramp {
    height: 8px;
    border-radius: 4px;
  }
  .legend .ramp-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.6rem;
    margin-top: 0.3rem;
    color: rgba(255, 240, 215, 0.75);
  }
  .legend .swatch {
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    margin-right: 0.5em;
    vertical-align: -0.1em;
    background: rgba(141, 186, 194, 0.3);
    border: 1px dashed #8dbac2;
  }
  .places {
    margin-top: 1.2rem;
    display: grid;
    gap: 1.1rem;
  }
  .places h2 {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 240, 215, 0.5);
    margin-bottom: 0.3rem;
  }
  .places ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .places button {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    background: none;
    border: 0;
    border-bottom: 1px solid rgba(255, 233, 196, 0.08);
    color: inherit;
    font-family: var(--font-display);
    font-size: 1.02rem;
    text-align: left;
    padding: 0.42rem 0.2rem;
    cursor: pointer;
  }
  .places button .num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(255, 240, 215, 0.55);
    align-self: center;
  }
  .places button:hover,
  .places button[aria-current='true'] {
    color: var(--glow);
  }
  .panel-toggle {
    display: none;
  }

  .card {
    position: absolute;
    right: var(--gutter);
    bottom: 2.4rem;
    width: min(23rem, calc(100vw - 2 * var(--gutter)));
    background: var(--paper);
    color: var(--ink);
    border-radius: 16px;
    padding: 1.3rem 1.4rem 1.4rem;
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.7);
    z-index: 6;
  }
  .card .label {
    color: var(--ink-3);
  }
  .card h2 {
    font-size: 1.9rem;
    margin: 0.5rem 2rem 0.2rem 0;
  }
  .card .c-legal {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    margin: 0 0 1rem;
  }
  .card dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    margin: 0 0 1.2rem;
    padding: 0.9rem 0;
    border-block: 1px solid var(--rule);
  }
  .card dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .card dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-display);
    font-size: 1.08rem;
  }
  .card .close {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    border: 1px solid var(--rule);
    background: none;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
  .card .close:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .card .btn {
    width: 100%;
    justify-content: center;
  }

  .hover-tip {
    position: absolute;
    pointer-events: none;
    z-index: 7;
    transform: translate(12px, 12px);
    background: color-mix(in srgb, var(--night) 90%, transparent);
    border: 1px solid var(--rule-night);
    border-radius: 6px;
    padding: 0.35rem 0.6rem;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: #fff6e3;
  }
  .hint {
    position: absolute;
    left: 50%;
    bottom: 1.1rem;
    transform: translateX(-50%);
    margin: 0;
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 240, 215, 0.7);
    background: color-mix(in srgb, var(--night) 60%, transparent);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    white-space: nowrap;
    transition: opacity 0.6s;
    pointer-events: none;
  }
  .hint.gone {
    opacity: 0;
  }

  @media (max-width: 760px) {
    .panel {
      left: 0.6rem;
      right: 0.6rem;
      width: auto;
      max-height: 62svh;
    }
    .panel-body {
      display: none;
    }
    .panel.open .panel-body {
      display: block;
    }
    .panel-toggle {
      display: block;
      background: none;
      border: 0;
      border-top: 1px solid var(--rule-night);
      color: rgba(255, 240, 215, 0.8);
      font-family: var(--font-mono);
      font-size: 0.64rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      padding: 0.7rem;
      cursor: pointer;
    }
    .card {
      left: 0.6rem;
      right: 0.6rem;
      bottom: 0.6rem;
      width: auto;
    }
    .hint {
      display: none;
    }
  }
</style>

<script>
  import { BASE, dataUrl, findTract, getJson, getSummary, tractBounds, type Summary, type Tract } from '../lib/data';
  import { acresLabel, labelFromId, patentNumberLabel, tractTitle, yearLabel, fmt } from '../lib/format';
  import {
    addLights, addPlaceLabels, addPlssLayers, addTractLayers, createMap, maplibregl, setBasemap, setTractColor,
    type PlssCollection,
  } from '../lib/map';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const params = new URLSearchParams(location.search);

  interface SearchIndex {
    twp: string[]; id: string[]; pat: string[]; t: number[]; s: number[]; sub: string[]; name: string[]; c: number[];
  }

  const summary: Summary = await getSummary();
  const start = summary.places.find((p) => p.id === (params.get('place') ?? ''));
  const hasHash = location.hash.length > 3;

  const map = createMap({
    container: $('map'),
    mood: 'day',
    center: start ? [start.lon, start.lat] : [-116.75, 34.5],
    zoom: start ? 11.4 : 8.5,
    pitch: start ? 50 : 38,
    bearing: start ? -12 : 0,
    hash: true,
    exaggeration: 1.5,
  });

  if (!map) {
    $('map').remove();
    $('panel').remove();
    $('hint').remove();
    $('map-unavailable').hidden = false;
  } else {
    map.addControl(new maplibregl.NavigationControl({ visualizePitch: true }), 'bottom-right');
    map.addControl(new maplibregl.ScaleControl({ unit: 'imperial' }), 'bottom-left');

    let selected: number | string | null = null;
    let hovered: number | string | null = null;
    let index: SearchIndex | null = null;
    const panelToggle = $<HTMLButtonElement>('panel-toggle');
    const setPanelOpen = (open: boolean) => {
      $('panel').classList.toggle('open', open);
      panelToggle.setAttribute('aria-expanded', String(open));
    };

    const select = (fid: number | string | null) => {
      if (selected != null) map.setFeatureState({ source: 'tracts', id: selected }, { selected: false });
      selected = fid;
      if (fid != null) map.setFeatureState({ source: 'tracts', id: fid }, { selected: true });
    };

    function showCard(t: Tract) {
      const place = summary.places.find((p) => p.id === t.place);
      $('card').innerHTML = `
        <button type="button" class="close" aria-label="Close">×</button>
        <p class="label">${esc(place?.name ?? 'San Bernardino County')}</p>
        <h2>${esc(tractTitle(t))}</h2>
        <p class="c-legal">${esc(t.sub ?? '')}${t.sec != null ? ` · Sec. ${t.sec}` : ''} · ${esc(t.twpLabel ?? '')}</p>
        <dl>
          <div><dt>Patented</dt><dd>${esc(t.date ? String(t.year) : yearLabel(t))}</dd></div>
          <div><dt>Size</dt><dd>${esc(acresLabel(t))}</dd></div>
          <div><dt>Patent no.</dt><dd>${esc(patentNumberLabel(t.pat))}</dd></div>
        </dl>
        <a class="btn" href="${BASE}/tract/?id=${encodeURIComponent(t.id)}">Open this tract <span class="arrow">→</span></a>`;
      $('card').hidden = false;
      $('card').querySelector('.close')!.addEventListener('click', () => {
        $('card').hidden = true;
        select(null);
      });
    }

    async function openTract(id: string, fly: boolean) {
      const hit = await findTract(id);
      if (!hit) return;
      showCard(hit.tract);
      if (fly) {
        const b = tractBounds(hit.tract);
        const wide = window.innerWidth > 1000;
        map.fitBounds([[b[0], b[1]], [b[2], b[3]]], {
          padding: wide ? { top: 160, bottom: 160, left: 480, right: 440 } : 60,
          maxZoom: 15.4, pitch: 55, duration: 2200,
        });
      }
      // feature ids are assigned by position in tracts.geojson; find ours once the source has it
      const mark = () => {
        const f = map.querySourceFeatures('tracts', { filter: ['==', ['get', 'id'], id] })[0];
        if (f?.id != null) select(f.id);
        return Boolean(f);
      };
      if (!mark()) map.once('idle', mark);
    }

    function flyToPlace(pid: string) {
      const p = summary.places.find((x) => x.id === pid);
      if (!p?.bbox) return;
      const wide = window.innerWidth > 1000;
      map.fitBounds([[p.bbox[0], p.bbox[1]], [p.bbox[2], p.bbox[3]]], {
        padding: wide ? { top: 120, bottom: 80, left: 440, right: 80 } : 30,
        pitch: 52, bearing: -14, maxZoom: 13.2, duration: 2600,
      });
      document.querySelectorAll<HTMLButtonElement>('.places button').forEach((b) => b.setAttribute('aria-current', String(b.dataset.place === pid)));
    }

    map.on('load', async () => {
      map.addSource('county', { type: 'geojson', data: dataUrl('county.geojson') });
      map.addLayer({ id: 'county-line', type: 'line', source: 'county', paint: { 'line-color': '#fff3da', 'line-opacity': 0.5, 'line-width': 1.2, 'line-dasharray': [2, 3] } });

      map.addSource('class', { type: 'geojson', data: dataUrl('classifications.geojson') });
      map.addLayer({ id: 'class-fill', type: 'fill', source: 'class', layout: { visibility: 'none' }, paint: { 'fill-color': '#8dbac2', 'fill-opacity': 0.16 } });
      map.addLayer({ id: 'class-line', type: 'line', source: 'class', layout: { visibility: 'none' }, paint: { 'line-color': '#8dbac2', 'line-width': 1, 'line-dasharray': [3, 2], 'line-opacity': 0.8 } });

      const [lights, grid] = await Promise.all([getJson<number[]>('lights.json'), getJson<PlssCollection>('plss.geojson')]);
      addPlssLayers(map, grid);
      map.addSource('tracts', { type: 'geojson', data: dataUrl('tracts.geojson') });
      addTractLayers(map, 'tracts', 'tract', { minzoom: 10.2 });
      addLights(map, lights, 12.4);
      addPlaceLabels(map, summary.places);

      // hover + click
      const tip = $('tip');
      map.on('mousemove', 'tract-fill', (e) => {
        const f = e.features?.[0];
        if (!f || f.id == null) return;
        map.getCanvas().style.cursor = 'pointer';
        if (hovered != null && hovered !== f.id) map.setFeatureState({ source: 'tracts', id: hovered }, { hover: false });
        hovered = f.id;
        map.setFeatureState({ source: 'tracts', id: hovered }, { hover: true });
        const y = Number(f.properties.y);
        tip.textContent = `${f.properties.n || labelFromId(String(f.properties.id))}${y ? ` · ${y}` : ''}`;
        tip.style.left = `${e.point.x}px`;
        tip.style.top = `${e.point.y}px`;
        tip.hidden = false;
      });
      map.on('mouseleave', 'tract-fill', () => {
        map.getCanvas().style.cursor = '';
        tip.hidden = true;
        if (hovered != null) map.setFeatureState({ source: 'tracts', id: hovered }, { hover: false });
        hovered = null;
      });
      map.on('click', 'tract-fill', (e) => {
        const f = e.features?.[0];
        if (!f) return;
        select(f.id ?? null);
        openTract(String(f.properties.id), false);
      });
      map.on('zoom', () => $('hint').classList.toggle('gone', map.getZoom() > 11));

      const wanted = params.get('tract');
      if (wanted) openTract(wanted.toUpperCase(), true);
      else if (start && !hasHash) flyToPlace(start.id);
    });

    // ------------------------------------------------------------ toggles
    const toggle = (id: string, fn: (on: boolean) => void) => {
      const b = $(id);
      b.addEventListener('click', () => {
        const on = b.getAttribute('aria-pressed') !== 'true';
        b.setAttribute('aria-pressed', String(on));
        fn(on);
      });
    };
    toggle('tg-year', (on) => {
      setTractColor(map, 'tract', on);
      $('legend').hidden = !on;
    });
    toggle('tg-grid', (on) => {
      for (const l of ['plss-line', 'plss-label']) map.setLayoutProperty(l, 'visibility', on ? 'visible' : 'none');
    });
    toggle('tg-class', (on) => {
      for (const l of ['class-fill', 'class-line']) map.setLayoutProperty(l, 'visibility', on ? 'visible' : 'none');
      $('legend-class').hidden = !on;
    });
    toggle('tg-topo', (on) => setBasemap(map, on ? 'topo' : 'imagery'));
    toggle('tg-3d', (on) => {
      map.setTerrain(on ? { source: 'dem', exaggeration: 1.5 } : null);
      map.easeTo({ pitch: on ? 50 : 0, duration: 900 });
    });

    document.querySelectorAll<HTMLButtonElement>('.places button').forEach((b) => b.addEventListener('click', () => {
      flyToPlace(b.dataset.place!);
      if (panelToggle.getClientRects().length) panelToggle.focus();
      setPanelOpen(false);
    }));
    panelToggle.addEventListener('click', () => setPanelOpen(panelToggle.getAttribute('aria-expanded') !== 'true'));

    // ------------------------------------------------------------ search
    const q = $<HTMLInputElement>('q');
    const results = $('results');
    const searchStatus = $('atlas-search-status');
    let indexFailed = false;
    type Hit = { main: string; kind: string; sub: string; go: () => void };

    const twpLabel = (key: string) => {
      const [, t, r] = key.split('-');
      return `T${t.replace('h', '½')} R${r.replace('h', '½')}`;
    };

    function search(raw: string): Hit[] {
      const text = raw.trim();
      if (text.length < 2 || !index) return [];
      const hits: Hit[] = [];
      const up = text.toUpperCase();
      const tractHit = (i: number): Hit => ({
        main: index!.name[i].replace(/; /g, ' & ') || labelFromId(index!.id[i]),
        kind: index!.name[i] ? labelFromId(index!.id[i]) : index!.pat[i] ? `No. ${index!.pat[i]}` : 'Tract',
        sub: `${index!.sub[i]} · Sec. ${index!.s[i]} · ${twpLabel(index!.twp[index!.t[i]])}`,
        go: () => openTract(index!.id[i], true),
      });

      for (const p of summary.places) {
        if (p.tracts && p.name.toUpperCase().includes(up)) {
          hits.push({ main: p.name, kind: 'Place', sub: `${fmt(p.tracts)} tracts`, go: () => flyToPlace(p.id) });
        }
      }

      const tr = /T?\s*(\d{1,2})\s*([NS])\b[\s,]*R?\s*(\d{1,2})\s*([EW])\b(?:.*?(?:SEC(?:TION)?\.?|§)\s*(\d{1,2}))?/.exec(up);
      if (tr) {
        const suffix = `-${Number(tr[1])}${tr[2]}-${Number(tr[3])}${tr[4]}`;
        const ti = index.twp.findIndex((k) => k.endsWith(suffix));
        const twp = summary.townshipList.find((t) => t.key.endsWith(suffix));
        if (twp && !tr[5]) {
          hits.push({
            main: twp.label, kind: 'Township', sub: `${fmt(twp.tracts)} tracts`,
            go: () => map.fitBounds([[twp.bbox[0], twp.bbox[1]], [twp.bbox[2], twp.bbox[3]]], { padding: 120, pitch: 45, duration: 2200 }),
          });
        }
        if (ti >= 0 && tr[5]) {
          const sec = Number(tr[5]);
          for (let i = 0; i < index.id.length && hits.length < 40; i++) if (index.t[i] === ti && index.s[i] === sec) hits.push(tractHit(i));
        }
      }

      const digits = up.replace(/[^0-9]/g, '');
      if (digits.length >= 3 && !tr) {
        for (let i = 0; i < index.id.length && hits.length < 30; i++) {
          if (index.pat[i].startsWith(digits) || index.id[i].replace(/-/g, '').endsWith(digits) || index.id[i].includes(digits)) hits.push(tractHit(i));
        }
      }
      if (/[A-Z]{3,}/.test(up) && !tr) {
        for (let i = 0; i < index.id.length && hits.length < 30; i++) if (index.name[i] && index.name[i].toUpperCase().includes(up)) hits.push(tractHit(i));
      }
      return hits.slice(0, 30);
    }

    function renderResults(hits: Hit[], text: string) {
      results.hidden = text.trim().length < 2;
      const message = indexFailed ? 'The search index couldn’t load. Reload the page to try again.'
        : index ? 'No matches. Try a shorter name or a tract number.' : 'Loading the search index…';
      searchStatus.textContent = results.hidden ? '' : hits.length
        ? `${hits.length} search result${hits.length === 1 ? '' : 's'}` : message;
      results.innerHTML = hits.length
        ? hits.map((h, i) => `<li><button type="button" data-i="${i}"><span class="r-main">${esc(h.main)}</span><span class="r-kind">${esc(h.kind)}</span><span class="r-sub">${esc(h.sub)}</span></button></li>`).join('')
        : `<li class="empty">${message}</li>`;
      results.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
        hits[Number(b.dataset.i)].go();
        results.hidden = true;
        q.focus();
      }));
    }

    const loadIndex = () => {
      if (!index) getJson<SearchIndex>('search.json').then((ix) => {
        index = ix;
        if (q.value) renderResults(search(q.value), q.value);
      }).catch(() => {
        indexFailed = true;
        if (q.value) renderResults([], q.value);
      });
    };
    q.addEventListener('focus', loadIndex, { once: true });
    $('lucky').addEventListener('click', async () => {
      index ??= await getJson<SearchIndex>('search.json');
      openTract(index.id[Math.floor(Math.random() * index.id.length)], true);
      if (panelToggle.getClientRects().length) panelToggle.focus();
      setPanelOpen(false);
    });
    q.addEventListener('input', () => renderResults(search(q.value), q.value));
    q.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') results.querySelector<HTMLButtonElement>('button')?.click();
      if (e.key === 'Escape') { results.hidden = true; searchStatus.textContent = ''; }
    });
  }
</script>
